{
  "name": "saferoad-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SafeRoad+ Mission-Critical Backend Server & Telemetry Engine",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^0.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
