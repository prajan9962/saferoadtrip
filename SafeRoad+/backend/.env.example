# SafeRoad+ Backend Environment Variables
PORT=3000
NODE_ENV=development

# Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=

# Firebase Admin Credentials (Optional for local emulation)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenRouteService API Key (For backend elevation & routing)
ORS_API_KEY=

# Database Connection (PostgreSQL / Cloud SQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/saferoad
